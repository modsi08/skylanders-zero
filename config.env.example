# Optional settings. Installed once as /etc/skylanders-zero.env; never overwritten.
# Trusted local network only by default; no token is configured.
# SKYLANDERS_TOKEN=choose-a-long-random-token
# With a token, open http://PI-IP:8080/?token=YOUR_TOKEN in the browser.
# SKYLANDERS_DATA=/opt/skylanders-zero/figures
# SKYLANDERS_AUDIO_DEVICE=default
# SKYLANDERS_LOG_LEVEL=INFO
